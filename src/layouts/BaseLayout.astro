---
import ThemeToggle from '../components/ThemeToggle.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: { src: string; alt: string };
  article?: { publishedDate: Date; updatedDate?: Date };
  reading?: boolean;
}

const {
  title = 'Jarek Avi',
  description = 'Software engineer and founder building software products and writing about engineering, product, and distribution.',
  image,
  article,
  reading = false,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = image && { url: new URL(image.src, Astro.site), alt: image.alt };
const navigation = [
  { href: '/about', label: 'About' },
  { href: '/articles', label: 'Articles' },
];
// Load the complete typography set consistently on every route.
const fonts = [
  'biotif-regular',
  'biotif-regular-italic',
  'biotif-book',
  'biotif-bold',
  'neuzeit-grotesk-bold',
  'fira-code-regular',
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {fonts.map((font) => <link rel="preload" href={`/static/fonts/${font}.woff2`} as="font" type="font/woff2" crossorigin />)}
    <script is:inline>
      // Apply a saved override before paint; CSS handles the system default.
      try {
        const theme = localStorage.getItem('theme');
        if (theme === 'light' || theme === 'dark') {
          document.documentElement.dataset.theme = theme;
        }
      } catch {
        // Storage may be unavailable; the system preference still works.
      }
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:site_name" content="Jarek Avi" />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content={socialImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {socialImage && <>
      <meta property="og:image" content={socialImage.url} />
      <meta property="og:image:alt" content={socialImage.alt} />
      <meta name="twitter:image" content={socialImage.url} />
      <meta name="twitter:image:alt" content={socialImage.alt} />
    </>}
    {article && <>
      <meta name="author" content="Jarek Avi" />
      <meta property="article:author" content={new URL('/about', Astro.site)} />
      <meta property="article:published_time" content={article.publishedDate.toISOString()} />
      {article.updatedDate && <meta property="article:modified_time" content={article.updatedDate.toISOString()} />}
    </>}
    <slot name="head" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script
      is:inline
      src="https://analytics.ahrefs.com/analytics.js"
      data-key="mSeAUIdyvS6nyCx0Y28Agw"
      async
    ></script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-container site-header">
      <a class="site-name" href="/">Jarek Avi</a>
      <div class="header-actions">
        <nav aria-label="Main navigation">
          {navigation.map(({ href, label }) => (
            <a href={href} aria-current={Astro.url.pathname === href || Astro.url.pathname.startsWith(`${href}/`) ? 'page' : undefined}>{label}</a>
          ))}
        </nav>
        <ThemeToggle />
      </div>
    </header>
    <main id="main" class:list={['site-container', { reading }]} tabindex="-1">
      <slot />
    </main>
    <footer class="site-container site-footer">
      <a href="https://x.com/JarekAvi">Twitter</a>
    </footer>
  </body>
</html>

<style>
  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: clamp(1.25rem, 3vw, 2rem);
    min-height: 5.25rem;
  }

  .site-name { font-size: 1.125rem; font-weight: 500; text-decoration: none; }
  main.site-container {
    flex: 1;
    display: flex;
    align-items: center;
    padding-block: clamp(2rem, 5vh, 4rem);
  }

  .header-actions { display: flex; align-items: center; gap: 1.5rem; }
  nav { display: flex; gap: 1.5rem; }
  nav a { font-size: 0.875rem; color: var(--text-secondary); text-decoration: none; }
  nav a:hover, nav a[aria-current] { color: var(--text-primary); }
  nav a[aria-current] { text-decoration: underline; text-underline-offset: 0.5rem; }
  main.reading {
    display: block;
    padding-block: clamp(2rem, 5vw, 4rem) var(--space-page);
  }

  .site-footer {
    padding-block: 1.5rem;
    color: var(--text-secondary);
    font-size: 0.875rem;
  }

  .site-footer a { text-decoration: none; }
  .site-footer a:hover { color: var(--text-primary); text-decoration: underline; }

  @media (max-width: 30rem) {
    .site-header { flex-wrap: wrap; }
    .header-actions { width: 100%; justify-content: space-between; }
  }
</style>
