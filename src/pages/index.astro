---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectItem from '../components/ProjectItem.astro';
---

<BaseLayout>
  <Fragment slot="head">
    <link rel="preload" href="/me.svg" as="image" />
    <link rel="preload" href="/images/projects/stage-captions-favicon.svg" as="image" />
  </Fragment>
  <div class="homepage">
    <section class="intro" aria-labelledby="intro-heading">
      <img class="mb-8 block size-24 rounded-lg" src="/me.svg" alt="Jarek Avi" width="96" height="96" />
      <h1 id="intro-heading">
        <span class="intro-greeting">Hi, I'm Jarek.</span> I'm a software engineer
        trying to make it as an indie hacker outside my 9-5.
      </h1>
      <div class="mt-6 space-y-1 leading-normal">
        <p class="text-sm text-[var(--text-secondary)]">Writing about</p>
        <p class="font-medium text-[var(--text-primary)]">Engineering · Product · Distribution</p>
      </div>
    </section>

    <section class="currently-building" aria-labelledby="building-heading">
      <h2 id="building-heading">Currently building</h2>
      <ProjectItem
        name="Stage Captions"
        description="Real-time captions and translation for live events."
        url="https://stagecaptions.io"
        icon="/images/projects/stage-captions-favicon.svg"
      />
    </section>
  </div>
</BaseLayout>

<style>
  .homepage {
    width: 100%;
    max-width: var(--prose-width);
  }

  .intro h1 {
    color: var(--text-secondary);
    font-family: var(--font-sans);
    font-size: clamp(1.75rem, 3.2vw, 2.25rem);
    font-weight: 400;
    line-height: 1.35;
    letter-spacing: -0.02em;
    text-wrap: pretty;
  }

  .intro-greeting {
    color: var(--text-primary);
    font-family: var(--font-display);
    font-weight: 700;
  }

  .currently-building {
    margin-top: clamp(3rem, 7vh, 5rem);
  }

  .currently-building h2 {
    color: var(--text-secondary);
    font-family: var(--font-sans);
    font-size: 0.875rem;
    font-weight: 400;
    letter-spacing: normal;
  }

</style>
