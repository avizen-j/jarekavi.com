---
import BaseLayout from '../layouts/BaseLayout.astro';

const description = 'Jarek Avi is a software engineer based in Vilnius, building backend systems since 2019 and working on Stage Captions with his co-founder Martin.';
const url = new URL('/about', Astro.site).href;
const person = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  url,
  mainEntity: {
    '@type': 'Person',
    '@id': new URL('/#person', Astro.site).href,
    name: 'Jarek Avi',
    url: new URL('/', Astro.site).href,
    description,
    jobTitle: 'Software engineer',
    homeLocation: { '@type': 'City', name: 'Vilnius' },
    alumniOf: { '@type': 'CollegeOrUniversity', name: 'Vilnius University' },
    image: new URL('/me.svg', Astro.site).href,
    sameAs: ['https://x.com/JarekAvi'],
  },
};
---

<BaseLayout title="About | Jarek Avi" description={description} reading>
  <Fragment slot="head">
    <link rel="preload" href="/me.svg" as="image" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(person).replace(/</g, '\\u003c')} />
  </Fragment>
  <h1>How I got here</h1>
  <div class="about-story">
    <div class="about-intro">
      <img src="/me.svg" alt="Jarek Avi" width="200" height="200" />
      <p>I'm a software engineer from Vilnius, Lithuania. I've been building backend-heavy systems while working a corporate job at a bank since 2019. However, I always had a desire to have something "for myself" and it only kept growing throughout the years. That's why most weekends, evenings and pretty much all my free time went into side projects. Later, I found out about the term "indie hacking" and that described pretty well what I would love to do full-time.</p>
    </div>
    <div class="about-background">
      <p>Speaking of my academic background, I did my Software Engineering bachelor's at Vilnius University and later DeepTech Entrepreneurship master's degree. Main reason I went for it was to get better at the business side of building tech products.</p>
      <p>My early projects started with simple university lab/project assignments and then grew into more complex ideas. I remember, we even attempted to build a unified shipping platform for local courier services here in Lithuania, but it never went to actual production due to legal/business reasons.</p>
      <p>Currently, I'm mostly focused on <a href="http://stagecaptions.io">stagecaptions.io</a>, which I'm building together with my co-founder Martin. We've had some successes with it, but I feel like it's still to early to leave the 9-5 and pursue it full time. Even though that's the goal.</p>
      <p>In the offline world, I love snowboarding, karting, swimming, climbing and surfing (tried once but already planning a camp). Overall, I'm definitely open to trying new things both online and offline.</p>
    </div>
  </div>
</BaseLayout>

<style>
  .about-story { margin-top: 2.5rem; color: var(--text-secondary); }
  .about-intro { display: grid; grid-template-columns: 12.5rem minmax(0, 1fr); align-items: center; gap: 2rem; }
  .about-background { margin-top: 2.5rem; }
  .about-background p + p { margin-top: 1.5rem; }
  img { display: block; width: 100%; height: auto; border-radius: 8px; }
  a { color: var(--text-primary); }
  .about-story a { text-decoration: none; }
  @media (max-width: 40rem) {
    .about-intro { grid-template-columns: 1fr; gap: 2rem; }
    img { max-width: 12.5rem; }
  }
</style>
