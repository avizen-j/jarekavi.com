---
interface Props {
  name: string;
  description: string;
  url: string;
  icon: string;
}

const { name, description, url, icon } = Astro.props;
---

<a class="project" href={url}>
  <span class="project-brand">
    <img src={icon} alt="" width="64" height="64" />
  </span>
  <span class="project-copy">
    <span class="project-name">{name}</span>
    <span class="project-description">{description}</span>
  </span>
</a>

<style>
  .project {
    display: grid;
    grid-template-columns: 4rem minmax(0, 1fr);
    align-items: center;
    gap: 1rem;
    /* Let the highlight extend outward while keeping content aligned. */
    margin: 0.25rem -0.75rem -0.75rem;
    padding: 0.75rem;
    border-radius: 8px;
    text-decoration: none;
  }

  @media (hover: hover) {
    .project:hover {
      background-color: var(--surface);
    }
  }

  .project:focus-visible,
  .project:active {
    background-color: var(--surface);
  }

  .project-brand {
    display: block;
    overflow: hidden;
    aspect-ratio: 1;
    border-radius: 5px;
    background-color: light-dark(#000, transparent);
  }

  .project-brand img {
    display: block;
    width: 100%;
    height: auto;
  }

  .project-copy { min-width: 0; }
  .project-name {
    display: block;
    font-weight: 500;
    line-height: 1.4;
  }

  .project-description {
    display: block;
    margin-top: 0.25rem;
    line-height: 1.5;
    color: var(--text-secondary);
  }
</style>
