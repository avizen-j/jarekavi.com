<button type="button" class="theme-toggle" data-theme-toggle aria-label="Switch to dark theme" hidden>
  <svg data-sun width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true" focusable="false">
    <circle cx="12" cy="12" r="4" />
    <path d="M12 2v2m0 16v2M2 12h2m16 0h2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M4.93 19.07l1.42-1.42m11.3-11.3 1.42-1.42" />
  </svg>
  <svg data-moon width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
    <path d="M20.9 13.3A9 9 0 0 1 10.7 3.1a9 9 0 1 0 10.2 10.2Z" />
  </svg>
</button>

<script>
  const systemTheme = window.matchMedia('(prefers-color-scheme: dark)');
  const root = document.documentElement;
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]');
  const isDark = () => root.dataset.theme
    ? root.dataset.theme === 'dark'
    : systemTheme.matches;

  function updateControls() {
    const dark = isDark();
    buttons.forEach((button) => {
      button.setAttribute('aria-label', `Switch to ${dark ? 'light' : 'dark'} theme`);
      button.querySelector('[data-sun]')?.setAttribute('style', `display: ${dark ? 'block' : 'none'}`);
      button.querySelector('[data-moon]')?.setAttribute('style', `display: ${dark ? 'none' : 'block'}`);
      button.hidden = false;
    });
  }

  buttons.forEach((button) => {
    button.addEventListener('click', () => {
      const theme = isDark() ? 'light' : 'dark';
      root.dataset.theme = theme;
      try {
        localStorage.setItem('theme', theme);
      } catch {
        // Keep the toggle usable even when preferences cannot be saved.
      }
      updateControls();
    });
  });
  systemTheme.addEventListener('change', updateControls);
  updateControls();
</script>

<style>
  .theme-toggle {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: var(--text-secondary);
    cursor: pointer;
  }

  .theme-toggle[hidden] { display: none; }
  .theme-toggle:hover { color: var(--text-primary); }
</style>
